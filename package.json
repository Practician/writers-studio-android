{
  "name": "react-example",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_AUTONOMOUS=true vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:legacy-server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --minify --outfile=dist-legacy/server.cjs",
